generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Persona {
  id              String        @id @default(uuid()) @db.Uuid
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @map("numero_documento")
  nombres         String
  apellidos       String
  correo          String
  telefono        String?
  direccion       String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  cliente         Cliente?
  empleado        Empleado?
  usuario         Usuario?

  @@unique([tipoDocumento, numeroDocumento], name: "uk_persona_documento")
  @@index([correo])
  @@index([apellidos, nombres])
  @@map("persona")
}

model Rol {
  id          String    @id @default(uuid()) @db.Uuid
  nombre      String    @unique
  descripcion String?
  permisos    Json      @default("[]")
  createdAt   DateTime  @default(now()) @map("created_at")
  usuarios    Usuario[]

  @@map("rol")
}

model Usuario {
  id                  String      @id @default(uuid()) @db.Uuid
  personaId           String      @unique @map("persona_id") @db.Uuid
  rolId               String      @map("rol_id") @db.Uuid
  username            String      @unique
  passwordHash        String      @map("password_hash")
  activo              Boolean     @default(true)
  ultimoAcceso        DateTime?   @map("ultimo_acceso")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  requiere2FA         Boolean     @default(true) @map("requiere_2fa")
  metodo2FAPreferido  Metodo2FA   @default(EMAIL) @map("metodo_2fa_preferido")
  debeCambiarPassword Boolean     @default(false) @map("debe_cambiar_password")
  passwordCambiadoEn  DateTime?   @map("password_cambiado_en")
  intentosFallidos    Int         @default(0) @map("intentos_fallidos")
  bloqueadoHasta      DateTime?   @map("bloqueado_hasta")
  auditorias          Auditoria[]
  codigoOtps          CodigoOtp[]
  persona             Persona     @relation(fields: [personaId], references: [id])
  rol                 Rol         @relation(fields: [rolId], references: [id])

  @@index([personaId])
  @@index([rolId])
  @@map("usuario")
}

model CodigoOtp {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  challengeToken String    @unique @map("challenge_token")
  codigoHash     String    @map("codigo_hash")
  tipo           TipoOtp   @map("tipo")
  metodo         Metodo2FA @default(EMAIL) @map("metodo")
  intentos       Int       @default(0)
  maxIntentos    Int       @default(3) @map("max_intentos")
  destinoEnvio   String    @map("destino_envio")
  expiraEn       DateTime  @map("expira_en")
  usado          Boolean   @default(false)
  usadoEn        DateTime? @map("usado_en")
  createdAt      DateTime  @default(now()) @map("created_at")
  usuario        Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, tipo])
  @@index([expiraEn])
  @@map("codigo_otp")
}

model Cliente {
  id              String      @id @default(uuid()) @db.Uuid
  personaId       String      @unique @map("persona_id") @db.Uuid
  activo          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  firmaRegistrada String?     @map("firma_registrada")
  persona         Persona     @relation(fields: [personaId], references: [id])
  fichaMadre      FichaMadre?

  @@map("cliente")
}

model Empleado {
  id          String       @id @default(uuid()) @db.Uuid
  personaId   String       @unique @map("persona_id") @db.Uuid
  cargo       String
  area        String?
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  persona     Persona      @relation(fields: [personaId], references: [id])
  fichasMadre FichaMadre[]

  @@map("empleado")
}

model FichaMadre {
  id            String             @id @default(uuid()) @db.Uuid
  codigo        String             @unique
  clienteId     String             @unique @map("cliente_id") @db.Uuid
  empleadoId    String             @map("empleado_id") @db.Uuid
  estado        EstadoFichaMadre   @default(PENDIENTE)
  observaciones String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  documentos    DocumentoGeneral[]
  cliente       Cliente            @relation(fields: [clienteId], references: [id])
  empleado      Empleado           @relation(fields: [empleadoId], references: [id])
  inversionista Inversionista?
  tokensAcceso  TokenAcceso[]

  @@index([empleadoId])
  @@index([estado])
  @@index([createdAt])
  @@map("ficha_madre")
}

model Inversionista {
  id                                String               @id @default(uuid()) @db.Uuid
  fichaMadreId                      String               @unique @map("ficha_madre_id") @db.Uuid
  esDomiciliado                     Boolean              @default(true) @map("es_domiciliado")
  usarMismaDireccionCorrespondencia Boolean              @default(true) @map("usar_misma_direccion_correspondencia")
  tieneApoderado                    Boolean              @default(false) @map("tiene_apoderado")
  createdAt                         DateTime             @default(now()) @map("created_at")
  updatedAt                         DateTime             @updatedAt @map("updated_at")
  antecedentesPenales               AntecedentesPenales?
  apoderado                         Apoderado?
  domicilios                        Domicilio[]
  informacionLaboral                InformacionLaboral?
  inversion                         Inversion?
  fichaMadre                        FichaMadre           @relation(fields: [fichaMadreId], references: [id])
  origenFondos                      OrigenFondos?
  residenciaFiscal                  ResidenciaFiscal?
  titular                           Titular?
  vinculaciones                     Vinculaciones?

  @@map("inversionista")
}

model Titular {
  id                      String         @id @default(uuid()) @db.Uuid
  inversionistaId         String         @unique @map("inversionista_id") @db.Uuid
  nombresApellidos        String?        @map("nombres_apellidos")
  tipoDocumento           TipoDocumento? @map("tipo_documento")
  numeroDocumento         String?        @map("numero_documento")
  nacionalidad            String?
  sexo                    String?
  paisNacimiento          String?        @map("pais_nacimiento")
  departamentoNacimiento  String?        @map("departamento_nacimiento")
  fechaNacimiento         String?        @map("fecha_nacimiento")
  paisResidencia          String?        @map("pais_residencia")
  gradoInstruccion        String?        @map("grado_instruccion")
  esInversionista         Boolean        @default(true) @map("es_inversionista")
  correoElectronico       String?        @map("correo_electronico")
  telefonoCelular         String?        @map("telefono_celular")
  conyugeNombresApellidos String?        @map("conyuge_nombres_apellidos")
  conyugeTipoDocumento    TipoDocumento? @map("conyuge_tipo_documento")
  conyugeNumeroDocumento  String?        @map("conyuge_numero_documento")
  fechaRegimen            String?        @map("fecha_regimen")
  pep                     Boolean        @default(false)
  pepInstitucionCargo     String?        @map("pep_institucion_cargo")
  estadoCivil             String?        @map("estado_civil")
  regimenPatrimonial      String?        @map("regimen_patrimonial")
  inversionista           Inversionista  @relation(fields: [inversionistaId], references: [id])

  @@map("titular")
}

model Domicilio {
  id                String        @id @default(uuid()) @db.Uuid
  inversionistaId   String        @map("inversionista_id") @db.Uuid
  tipo              TipoDomicilio @map("tipo")
  direccionCompleta String?       @map("direccion_completa")
  distrito          String?
  provincia         String?
  departamento      String?
  pais              String?
  codigoPostal      String?       @map("codigo_postal")
  numero            String?       @db.VarChar(100)
  inversionista     Inversionista @relation(fields: [inversionistaId], references: [id])

  @@unique([inversionistaId, tipo], name: "uk_domicilio_inversionista_tipo")
  @@index([inversionistaId])
  @@map("domicilio")
}

model InformacionLaboral {
  id                   String        @id @default(uuid()) @db.Uuid
  inversionistaId      String        @unique @map("inversionista_id") @db.Uuid
  situacionLaboral     String?       @map("situacion_laboral")
  profesion            String?
  ocupacion            String?
  empresaCentroTrabajo String?       @map("empresa_centro_trabajo")
  ingresoPromedioAnual Decimal?      @map("ingreso_promedio_anual") @db.Decimal(18, 2)
  inversionista        Inversionista @relation(fields: [inversionistaId], references: [id])

  @@map("informacion_laboral")
}

model Apoderado {
  id                String         @id @default(uuid()) @db.Uuid
  inversionistaId   String         @unique @map("inversionista_id") @db.Uuid
  nombresApellidos  String?        @map("nombres_apellidos")
  tipoDocumento     TipoDocumento? @map("tipo_documento")
  numeroDocumento   String?        @map("numero_documento")
  nacionalidad      String?
  sexo              String?
  paisNacimiento    String?        @map("pais_nacimiento")
  fechaNacimiento   String?        @map("fecha_nacimiento")
  paisResidencia    String?        @map("pais_residencia")
  gradoInstruccion  String?        @map("grado_instruccion")
  esDomiciliado     Boolean        @default(true) @map("es_domiciliado")
  correoElectronico String?        @map("correo_electronico")
  telefonoCelular   String?        @map("telefono_celular")
  partidaRegistral  String?        @map("partida_registral")
  asiento           String?
  zonaRegistral     String?        @map("zona_registral")
  estadoCivil       String?        @map("estado_civil")
  inversionista     Inversionista  @relation(fields: [inversionistaId], references: [id])

  @@map("apoderado")
}

model Vinculaciones {
  id                             String        @id @default(uuid()) @db.Uuid
  inversionistaId                String        @unique @map("inversionista_id") @db.Uuid
  esVinculadoCorfidGrupoCoril    Boolean       @default(false) @map("es_vinculado_corfid_grupo_coril")
  haSidoClienteOtraFiduciaria    Boolean       @default(false) @map("ha_sido_cliente_otra_fiduciaria")
  haSidoTrabajadorOtraFiduciaria Boolean       @default(false) @map("ha_sido_trabajador_otra_fiduciaria")
  valorAproximadoPatrimonio      Decimal?      @map("valor_aproximado_patrimonio") @db.Decimal(18, 2)
  inversionista                  Inversionista @relation(fields: [inversionistaId], references: [id])

  @@map("vinculaciones")
}

model OrigenFondos {
  id                               String        @id @default(uuid()) @db.Uuid
  inversionistaId                  String        @unique @map("inversionista_id") @db.Uuid
  fondosPropiosDetalle             String?       @map("fondos_propios_detalle")
  ventaActivosDetalle              String?       @map("venta_activos_detalle")
  financiamientosDetalle           String?       @map("financiamientos_detalle")
  dividendosParticipacionesDetalle String?       @map("dividendos_participaciones_detalle")
  contratoObraLicitacionDetalle    String?       @map("contrato_obra_licitacion_detalle")
  patrimonioFideicometidoDetalle   String?       @map("patrimonio_fideicometido_detalle")
  otrosFondosDetalle               String?       @map("otros_fondos_detalle")
  inversionista                    Inversionista @relation(fields: [inversionistaId], references: [id])

  @@map("origen_fondos")
}

model AntecedentesPenales {
  id                   String        @id @default(uuid()) @db.Uuid
  inversionistaId      String        @unique @map("inversionista_id") @db.Uuid
  esInvestigadoDelitos Boolean       @default(false) @map("es_investigado_delitos")
  especificarDelitos   String?       @map("especificar_delitos")
  inversionista        Inversionista @relation(fields: [inversionistaId], references: [id])

  @@map("antecedentes_penales")
}

model ResidenciaFiscal {
  id                              String                 @id @default(uuid()) @db.Uuid
  inversionistaId                 String                 @unique @map("inversionista_id") @db.Uuid
  tieneResidenciaFiscalExtranjera Boolean                @default(false) @map("tiene_residencia_fiscal_extranjera")
  inversionista                   Inversionista          @relation(fields: [inversionistaId], references: [id])
  paises                          ResidenciaFiscalPais[]

  @@map("residencia_fiscal")
}

model ResidenciaFiscalPais {
  id                 String           @id @default(uuid()) @db.Uuid
  residenciaFiscalId String           @map("residencia_fiscal_id") @db.Uuid
  pais               String?
  nitTin             String?          @map("nit_tin")
  orden              Int              @default(0)
  residenciaFiscal   ResidenciaFiscal @relation(fields: [residenciaFiscalId], references: [id])

  @@index([residenciaFiscalId])
  @@map("residencia_fiscal_pais")
}

model Inversion {
  id                 String        @id @default(uuid()) @db.Uuid
  inversionistaId    String        @unique @map("inversionista_id") @db.Uuid
  moneda             String?       @default("USD")
  montoInicial       Decimal?      @map("monto_inicial") @db.Decimal(18, 2)
  montoInicialLetras String?       @map("monto_inicial_letras")
  origenRecursos     String?       @map("origen_recursos")
  bancoNombre        String?       @map("banco_nombre")
  numeroCuenta       String?       @map("numero_cuenta")
  cuentaCci          String?       @map("cuenta_cci")
  inversionista      Inversionista @relation(fields: [inversionistaId], references: [id])

  @@map("inversion")
}

model DocumentoPlantilla {
  id          String             @id @default(uuid()) @db.Uuid
  nombre      String
  descripcion String?
  archivo     String
  formato     String
  version     Int                @default(1)
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  documentos  DocumentoGeneral[]

  @@map("documento_plantilla")
}

model DocumentoGeneral {
  id                   String                 @id @default(uuid()) @db.Uuid
  fichaMadreId         String                 @map("ficha_madre_id") @db.Uuid
  documentoPlantillaId String                 @map("documento_plantilla_id") @db.Uuid
  nombreArchivo        String                 @map("nombre_archivo")
  rutaArchivo          String                 @map("ruta_archivo")
  hashIntegridad       String?                @map("hash_integridad")
  version              Int                    @default(1)
  estado               EstadoDocumento        @default(PENDIENTE)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  documentoPlantilla   DocumentoPlantilla     @relation(fields: [documentoPlantillaId], references: [id])
  fichaMadre           FichaMadre             @relation(fields: [fichaMadreId], references: [id])
  firmas               Firma[]
  tokensDocumentos     TokenAccesoDocumento[]

  @@index([fichaMadreId])
  @@index([estado])
  @@map("documento_general")
}

model Firma {
  id                 String           @id @default(uuid()) @db.Uuid
  documentoGeneralId String           @map("documento_general_id") @db.Uuid
  tipo               TipoFirma        @default(ELECTRONICA)
  estado             EstadoFirma      @default(PENDIENTE)
  fechaFirma         DateTime?        @map("fecha_firma")
  ip                 String?
  userAgent          String?          @map("user_agent")
  hashFirma          String?          @map("hash_firma")
  datosCertificado   Json?            @map("datos_certificado")
  coordenadasPagina  Json?            @map("coordenadas_pagina")
  firmanteNombre     String?          @map("firmante_nombre")
  firmanteDocumento  String?          @map("firmante_documento")
  firmanteEmail      String?          @map("firmante_email")
  createdAt          DateTime         @default(now()) @map("created_at")
  tokenAccesoId      String?          @map("token_acceso_id") @db.Uuid
  documentoGeneral   DocumentoGeneral @relation(fields: [documentoGeneralId], references: [id])
  tokenAcceso        TokenAcceso?     @relation(fields: [tokenAccesoId], references: [id])

  @@index([documentoGeneralId])
  @@index([tokenAccesoId])
  @@map("firma")
}

model TokenAcceso {
  id                      String                 @id @default(uuid()) @db.Uuid
  fichaMadreId            String                 @map("ficha_madre_id") @db.Uuid
  token                   String                 @unique
  emailDestino            String                 @map("email_destino")
  documentosFirmaCantidad Int                    @default(5) @map("documentos_firma_cantidad")
  estado                  EstadoToken            @default(ACTIVO)
  expiraEn                DateTime               @map("expira_en")
  usadoEn                 DateTime?              @map("usado_en")
  intentos                Int                    @default(0)
  maxIntentos             Int                    @default(3) @map("max_intentos")
  createdAt               DateTime               @default(now()) @map("created_at")
  firmas                  Firma[]
  fichaMadre              FichaMadre             @relation(fields: [fichaMadreId], references: [id])
  documentos              TokenAccesoDocumento[]

  @@index([token])
  @@index([fichaMadreId])
  @@map("token_acceso")
}

model TokenAccesoDocumento {
  id                 String           @id @default(uuid()) @db.Uuid
  tokenAccesoId      String           @map("token_acceso_id") @db.Uuid
  documentoGeneralId String           @map("documento_general_id") @db.Uuid
  firmadoAt          DateTime?        @map("firmado_at")
  roundNumber        Int?             @map("round_number")
  documentoGeneral   DocumentoGeneral @relation(fields: [documentoGeneralId], references: [id])
  tokenAcceso        TokenAcceso      @relation(fields: [tokenAccesoId], references: [id])

  @@unique([tokenAccesoId, documentoGeneralId], name: "uk_token_documento")
  @@index([documentoGeneralId])
  @@map("token_acceso_documento")
}

model Auditoria {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String?  @map("usuario_id") @db.Uuid
  accion       String
  entidad      String
  entidadId    String   @map("entidad_id")
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("auditoria")
}

model asistentes_evento {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evento_id        String    @db.VarChar
  nombre           String    @db.VarChar
  correo           String    @db.VarChar
  celular          String?   @db.VarChar
  persona_contacto String?   @db.VarChar
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  eventos          eventos   @relation(fields: [evento_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model calendar_settings {
  id                 Int       @id @default(autoincrement())
  slot_duration      Int       @default(60)
  morning_start      String    @default("09:00") @db.VarChar(10)
  morning_end        String    @default("12:00") @db.VarChar(10)
  afternoon_start    String    @default("14:00") @db.VarChar(10)
  afternoon_end      String    @default("17:00") @db.VarChar(10)
  send_interval      Int       @default(5)
  send_interval_unit String    @default("minutes") @db.VarChar(20)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)
}

model email_queue {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_name  String    @db.VarChar(255)
  recipient_email String    @db.VarChar(255)
  proposed_time   DateTime  @db.Timestamptz(6)
  status          String    @default("pending") @db.VarChar(50)
  error_message   String?
  sent_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  recipient_phone String?   @db.VarChar(50)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model email_tracking_test {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_email String
  subject         String
  status          String    @default("Enviado")
  resend_email_id String    @unique
  sent_at         DateTime  @default(now()) @db.Timestamptz(6)
  opened_at       DateTime? @db.Timestamptz(6)
  proposed_time   DateTime? @db.Timestamptz(6)
  recipient_name  String?
}

model eventos {
  id                String              @id @db.VarChar
  nombre            String              @db.VarChar
  fecha_inicio      DateTime?           @db.Timestamptz(6)
  link_reunion      String?             @db.VarChar
  descripcion       String?
  duracion_minutos  Int?                @default(60)
  activo            Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  asistentes_evento asistentes_evento[]
}

enum TipoDocumento {
  DNI
  RUC
  CE
  PASAPORTE
}

enum TipoDomicilio {
  DOMICILIO
  CORRESPONDENCIA
  APODERADO
}

enum EstadoFichaMadre {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  EN_REVISION
  APROBADA
  RECHAZADA
}

enum EstadoDocumento {
  PENDIENTE
  GENERADO
  PENDIENTE_FIRMA
  PARCIAL_FIRMADO
  FIRMADO
  ANULADO
}

enum TipoFirma {
  SIMPLE
  ELECTRONICA
  AVANZADA
}

enum EstadoFirma {
  PENDIENTE
  FIRMADO
  RECHAZADO
}

enum EstadoToken {
  ACTIVO
  USADO
  EXPIRADO
  REVOCADO
}

enum Metodo2FA {
  EMAIL
  SMS
  TOTP_APP
}

enum TipoOtp {
  LOGIN_2FA
  PASSWORD_RESET
}
