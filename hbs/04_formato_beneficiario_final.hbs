<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>FORMATO DE LA PERSONA NATURAL QUE CALIFICA COMO BENEFICIARIO FINAL</title>
  <style>
    /* Configuración de Hoja Física A4 */
    @page {
      size: A4;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: Arial, 'Segoe UI', Helvetica, sans-serif;
      font-size: 8pt;
      line-height: 1.3;
      color: #000000;
      margin: 0;
      padding: 0;
    }

    /* Estilo de simulación de hoja física A4 en pantalla (3 hojas individuales) */
    @media screen {
      body {
        background-color: #e2e8f0;
        padding: 30px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
      }

      .page-a4 {
        background: #ffffff;
        width: 210mm;
        min-height: 297mm;
        padding: 18mm 15mm;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2), 0 2px 6px rgba(0, 0, 0, 0.1);
        border: 1px solid #cbd5e1;
        border-radius: 2px;
        position: relative;
      }
    }

    /* Estilo limpio para impresión o generación PDF multi-página */
    @media print {
      body {
        background: #ffffff;
      }

      .page-a4 {
        width: 100%;
        height: 297mm;
        max-height: 297mm;
        padding: 14mm 15mm;
        box-shadow: none;
        border: none;
        overflow: hidden;
        page-break-after: always;
        break-after: page;
      }

      .page-a4:last-child {
        page-break-after: avoid;
        break-after: avoid;
      }
    }

    .header-title {
      text-align: center;
      font-weight: bold;
      font-size: 9.5pt;
      margin-top: 0.5rem;
      margin-bottom: 3px;
      text-transform: uppercase;
    }

    .header-subtitle {
      text-align: center;
      font-size: 7.5pt;
      margin-bottom: 12px;
    }

    .section-title {
      font-weight: bold;
      font-size: 8.5pt;
      background-color: #e5e7eb;
      padding: 3px 6px;
      margin-top: 10px;
      margin-bottom: 5px;
      border: 1px solid #000000;
    }

    .table-data {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 10px;
      font-size: 7.5pt;
    }

    .table-data td,
    .table-data th {
      border: 1px solid #000000;
      padding: 3px 5px;
      vertical-align: top;
    }

    .table-data th {
      background-color: #f3f4f6;
      font-weight: bold;
      text-align: center;
    }

    .col-label {
      width: 38%;
      font-weight: 500;
      background-color: #f9fafb;
      font-size: 12px;
    }

    .footnote {
      font-size: 7.5pt;
      color: #252525;
      margin-top: 15px;
      border-top: 1px solid #cccccc;
      padding-top: 4px;
    }

    .text-decorator {
      text-transform: uppercase;
    }
  </style>
</head>

<body>

  <!-- HOJA 1 DE 3 -->
  <div class="page-a4">
    <!-- TITULO PRINCIPAL DE 2 LÍNEAS -->
    <div class="header-title">
      FORMATO DE LA PERSONA NATURAL QUE<br>CALIFICA COMO BENEFICIARIO FINAL
    </div>
    <div class="header-subtitle">
      (literal a) del párrafo 7.1 del artículo 7° del Reglamento del Decreto Legislativo N.° 1372)
    </div>

