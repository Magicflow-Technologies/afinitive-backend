<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>FORMATO DE FICHA CLIENTE PARA PERSONA NATURAL</title>
    <style>
      @page {
        size: A4;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      body {
        font-family: Arial, sans-serif;
        font-size: 7.5pt;
        line-height: 1.25;
        color: #000000;
        margin: 0;
        padding: 0;
      }

      @media screen {
        body {
          background-color: #e2e8f0;
          padding: 20px 0;
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 20px;
        }

        .page-a4 {
          background: #ffffff;
          width: 210mm;
          min-height: 297mm;
          padding: 12mm 12mm;
          box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
          border: 1px solid #cbd5e1;
          position: relative;
        }
      }

      @media print {
        body {
          background: #ffffff;
        }

        .page-a4 {
          width: 100%;
          height: 297mm;
          max-height: 297mm;
          padding: 5mm 9mm;
          box-shadow: none;
          border: none;
          overflow: hidden;
          page-break-after: always;
          break-after: page;
        }

        .page-a4:last-child {
          page-break-after: avoid;
          break-after: avoid;
        }
      }

      .top-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border: 1.5px solid #000000;
        padding: 2px 6px;
        margin-bottom: 2px;
        font-weight: bold;
      }

      .top-header img {
        height: 22px;
        width: auto;
      }

      .top-header .title {
        font-size: 8.5pt;
        text-align: center;
        flex-grow: 1;
      }

      .top-header .code {
        font-size: 7.5pt;
      }

      .sec-header {
        background-color: #0072c8;
        /* Azul oficial CORFID */
        color: #000;
        font-weight: bold;
        text-align: center;
        font-size: 7pt;
        padding: 0.5px;
        border: 1.5px solid #000000;
      }

      .tbl-form {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        margin-bottom: 1px;
      }

      .tbl-form td,
      .tbl-form th {
        border: 1px solid #000000;
        padding: 0.5px 3px;
        vertical-align: middle;
        word-wrap: break-word;
        overflow-wrap: break-word;
        line-height: 1.05;
      }

      .tbl-cabecera {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1px;
      }

      .tbl-cabecera td,
      .tbl-cabecera th {
        border: 1.5px solid #000000;
        padding: 1px 4px;
        vertical-align: middle;
      }

      .tbl-form .sub-title {
        background-color: #e5e7eb;
        font-weight: bold;
        font-size: 6.8pt;
        padding: 0.5px 3px;
      }

      .lbl {
        font-weight: normal;
        color: #000000;
        line-height: 1.02;
        font-size: 6.2pt;
      }

      .val {
        font-weight: normal;
        color: #000000;
        font-size: 6.2pt;
        text-align: center;
        line-height: 1.02;
      }

      .chk-box {
        display: inline-block;
        width: 9px;
        height: 9px;
        border: 1px solid #000000;
        text-align: center;
        line-height: 1.0;
        font-size: 6.5pt;
        margin-right: 2px;
      }

      .chk-box.checked::after {
        content: "✓";
        font-size: 10px;
        position: relative;
        left: 1px;
        top: -2px;
      }

      .notice-bar {
        background-color: #ffffff;
        font-weight: bold;
        font-size: 6.2pt;
        padding: 1px 3px;
        border-left: 1.5px solid #000;
        border-right: 1.5px solid #000;
      }

      .page-break {
        page-break-before: always;
      }

      .text-uppercase {
        text-transform: uppercase;
      }

      .no-border {
        border-top: none;
        border-bottom: none;
      }
    </style>
  </head>

  <body>
    <!-- HOJA 1 -->
    <div class="page-a4">
      <table class="tbl-cabecera">
        
        <tr>
          <td style="width: 20%"><img src="{{logo_corfid}}" alt="CORFID" style="width: 90px; height: 25px; object-fit: contain;" /></td>
          <td
            style="
              width: 60%;
              font-size: 9px;
              text-align: center;
              font-weight: bold;
            "
          >
            FORMATO DE FICHA CLIENTE PARA PERSONA NATURAL
          </td>
          <td
            style="
              width: 20%;
              font-size: 9px;
              font-weight: bold;
              text-align: center;
            "
          >
            FFCPN-V.01-2023
          </td>
        </tr>
        <tr>
          <td width="100%" colspan="3">Fecha de Aprobación: 30/10/2023</td>
        </tr>
      </table>

      <!-- 1. DATOS DE IDENTIFICACIÓN DEL CLIENTE -->
      <div class="sec-header">1. DATOS DE IDENTIFICACIÓN DEL CLIENTE</div>
      <div class="notice-bar">POR FAVOR COMPLETAR EN LOS CAMPOS EN BLANCO</div>

      <table class="tbl-form">
        <colgroup>
          <col style="width: 32%" />
          <col style="width: 18%" />
          <col style="width: 17%" />
          <col style="width: 33%" />
        </colgroup>
        <tr>
          <td colspan="4" class="sub-title">1.1. DATOS BÁSICOS</td>
        </tr>

        <!-- 1.1. NOMBRES Y ESTADO CIVIL -->
        <tr style="width: 100%">
          <td style="width: 32%; border-bottom: none" class="lbl">
            NOMBRES Y APELLIDOS (COMPLETOS):
          </td>

          <td
            style="width: 18%; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.nombres_apellidos}}
          </td>

          <td style="width: 17%; border-bottom: none" class="lbl">
            ESTADO CIVIL (QUE FIGURA EN SU DNI):
          </td>

          <td
            style="width: 33%; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.estado_civil}}
          </td>
        </tr>

        <!-- TIPO DE DOCUMENTO Y PAIS DE RESIDENCIA -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            TIPO DE DOCUMENTO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.tipo_documento}}
          </td>
          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            PAIS DE RESIDENCIA:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.pais_residencia}}
          </td>
        </tr>

        <!-- N° DOCUMENTO Y LUGAR DE NACIMIENTO -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NÚMERO DE DOCUMENTO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.numero_documento}}
          </td>
          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            LUGAR DE NACIMIENTO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.pais_nacimiento}}
          </td>
        </tr>

        <!-- NACIONALIDAD Y FECHA DE NACIMIENTO -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NACIONALIDAD:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.nacionalidad}}
          </td>
          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            FECHA DE NACIMIENTO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.fecha_nacimiento}}
          </td>
        </tr>

        <!-- SEXO Y GRADO DE INSTRUCCIÓN -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            SEXO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.sexo}}
          </td>
          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            GRADO DE INSTRUCCIÓN:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.grado_instruccion}}
          </td>
        </tr>

        <!-- EXPUESTA POLÍTICAMENTE Y ES UN INVERSIONISTA -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            ¿ES UD. UNA PERSONA EXPUESTA POLÍTICAMENTE?
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val"
          >
            &nbsp;&nbsp;
            <span
              class="chk-box {{#if fichaMadre.inversionista.titular.pep}}checked{{/if}}"
            ></span>
            Sí &nbsp;&nbsp;
            <span
              class="chk-box {{#unless fichaMadre.inversionista.titular.pep}}checked{{/unless}}"
            ></span>
            No<br />
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            ¿ES UD. UN INVERSIONISTA?
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            <span class="chk-box {{#if es_inversionista}}checked{{/if}}"></span
            >Sí &nbsp;&nbsp;
            <span
              class="chk-box {{#unless es_inversionista}}checked{{/unless}}"
            ></span>
            No
          </td>
        </tr>

        <!-- PEP -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *SI ES PEP; INDICAR LA INSTITUCIÓN Y CARGO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.pep_institucion_cargo}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          ></td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          ></td>
        </tr>

        <!-- 1.2. DIRECCIÓN DE DOMICILIO -->
        <tr>
          <td colspan="4" class="sub-title">1.2. DIRECCIÓN DE DOMICILIO</td>
        </tr>

        <!-- ES DOMICILIADO y *PAIS DEL DOMICILIO -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *¿ES USTED DOMICILIADO?:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            &nbsp;&nbsp;
            <span
              class="chk-box {{#if fichaMadre.inversionista.es_domiciliado}}checked{{/if}}"
            ></span>
            Sí &nbsp;&nbsp;
            <span
              class="chk-box {{#unless fichaMadre.inversionista.es_domiciliado}}checked{{/unless}}"
            ></span>
            No<br />
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *PAIS DEL DOMICILIO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.domicilio.pais_domicilio}}
          </td>
        </tr>

        <!-- DISTRITO  Y PROVINCIA -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            DISTRITO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.domicilio.distrito}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            PROVINCIA:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.domicilio.provincia}}
          </td>
        </tr>

        <!-- DEPARTAMENTO Y DIRECCION DE DOMICILIO -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            DEPARTAMENTO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.domicilio.departamento}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *DIRECCIÓN DE DOMICILIO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.domicilio.direccion_completa}}
          </td>
        </tr>

        <!-- TELEFONO FIJO O CELULAR Y EMAIL -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *TELEFONO FIJO O CELULAR:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.titular.telefono_celular}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            EMAIL:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val"
          >
            {{fichaMadre.inversionista.titular.correo_electronico}}
          </td>
        </tr>

        <!-- 1.3. DATOS LABORALES -->
        <tr>
          <td colspan="4" class="sub-title">1.3. DATOS LABORALES</td>
        </tr>

        <!-- SITUACION LABORAL / OMBRE DEL CENTRO DE TRABAJO -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *SITUACIÓN LABORAL:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{situacion_laboral}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NOMBRE DEL CENTRO DE TRABAJO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.informacion_laboral.empresa_centro_trabajo}}
          </td>
        </tr>

        <!-- PROFESION / OCUPACION -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *PROFESIÓN:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.informacion_laboral.profesion}}
          </td>

          <td
            rowspan="2"
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *OCUPACIÓN:
          </td>
          <td
            rowspan="2"
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.informacion_laboral.ocupacion}}
          </td>
        </tr>

        <!-- INGRESO PROMEDIO ANUAL -->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *INGRESO PROMEDIO ANUAL:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.informacion_laboral.ingreso_promedio_anual}}
          </td>
        </tr>

        <!-- 1.4. DIRECCIÓN DE CORRESPONDENCIA -->
        <tr>
          <td colspan="4" class="sub-title">
            1.4. DIRECCIÓN DE CORRESPONDENCIA
          </td>
        </tr>

        <!-- DIRECCION CORRESPONDENCIA ES LA MISMA / DEPARTAMENTO-->
        <tr>
          <td
            rowspan="2"
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            *SU DIRECCIÓN DE CORRESPONDENCIA ES LA MISMA QUE:<br />
            En caso no ser su domicilio, completar direccion:
          </td>
          <!-- Esta celda se extiende hacia abajo abarcando las 3 filas y centra el checkbox -->
          <td
            rowspan="2"
            style="
              width: 18%;
              text-align: center;
              vertical-align: middle;
              border-top: none;
              border-bottom: none;
            "
          >
            &nbsp;&nbsp;&nbsp;&nbsp;
            <span
              class="chk-box {{#if fichaMadre.inversionista.usar_misma_direccion_correspondencia}}checked{{/if}}"
            ></span>
            <span class="val">Domicilio</span>
            &nbsp;&nbsp;&nbsp;&nbsp;
          </td>
          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            DEPARTAMENTO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.direccion_correspondencia.departamento}}
          </td>
        </tr>

        <!-- FILA 2 (La columna 2 ya no se pone aquí porque la ocupa el rowspan de arriba) -->
        <tr>
          <td class="lbl" style="border-top: none; border-bottom: none">
            *PAÍS DEL DOMICILIO:
          </td>
          <td
            class="val text-uppercase"
            style="border-top: none; border-bottom: none"
          >
            {{fichaMadre.inversionista.direccion_correspondencia.pais_domicilio}}
          </td>
        </tr>

        <!-- DISTRITO-CORRESPONDENCIA -->
        <tr>
          <td class="lbl" style="border-top: none; border-bottom: none">
            DISTRITO:
          </td>
          <td
            class="val text-uppercase"
            style="border-top: none; border-bottom: none"
          >
            {{fichaMadre.inversionista.direccion_correspondencia.distrito}}
          </td>

          <td class="lbl" style="border-top: none; border-bottom: none">
            PROVINCIA:
          </td>
          <td
            class="val text-uppercase"
            style="border-top: none; border-bottom: none"
          >
            {{fichaMadre.inversionista.direccion_correspondencia.provincia}}
          </td>
        </tr>

        <!-- 2. DATOS DEL APODERADO -->
        <tr>
          <td colspan="4" class="sec-header">
            2. DATOS DEL APODERADO (SÓLO EN CASO DE QUE APLIQUE)
          </td>
        </tr>

        <tr>
          <td colspan="4" class="sub-title">2.1. DATOS BÁSICOS</td>
        </tr>

        <!-- DATOS BASICOS APODRADO-->
        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NOMBRES Y APELLIDOS (COMPLETOS):
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.nombres_apellidos}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            ESTADO CIVIL (QUE FIGURA EN SU DNI):
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.estado_civil}}
          </td>
        </tr>

        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            TIPO DE DOCUMENTO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.tipo_documento}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            PAIS DE NACIMIENTO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.pais_nacimiento}}
          </td>
        </tr>

        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NÚMERO DE DOCUMENTO:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.numero_documento}}
          </td>

          <td
            style="width: 17%; border-top: none; border-bottom: none"
            class="lbl"
          >
            FECHA DE NACIMIENTO:
          </td>
          <td
            style="width: 33%; border-top: none; border-bottom: none"
            class="val text-uppercase"
          >
            {{fichaMadre.inversionista.apoderado.fecha_nacimiento}}
          </td>
        </tr>

        <tr>
          <td
            style="width: 32%; border-top: none; border-bottom: none"
            class="lbl"
          >
            NACIONALIDAD:
          </td>
          <td
            style="width: 18%; border-top: none; border-bottom: none"
